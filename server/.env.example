# 后端环境变量示例（复制为 .env 使用）
PORT=3001
CACHE_TTL=300
CLIENT_ORIGIN=http://localhost:5173

# 第二阶段 AI（DeepSeek）。AI_ENABLED=false 时不调用 AI，基础热榜照常。
# 启用 AI：把 AI_ENABLED 设为 true，并填入真实 key 与受支持的模型名。
AI_ENABLED=false
DEEPSEEK_API_KEY=your_api_key
DEEPSEEK_MODEL=replace_with_supported_model
# 可选：覆盖 DeepSeek 接口地址（默认 https://api.deepseek.com/chat/completions）
# DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions
